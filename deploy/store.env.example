# Copy-ready: copy this file as-is to /srv/guates/store/shared/store.env (owner guates, mode 600) and replace the <placeholders>.
# systemd EnvironmentFile keeps text after a value, so every comment is on its own line.
# Pre-launch values are set. Live changes: PULSO_MODE=live, INDEXING=on, ORDER_PREFIX=WEB, Wompi keys pub_prod_/prv_prod_/prod_events_/prod_integrity_.
# The server refuses to start on an unsafe mix: production keys need PULSO_MODE=live and ORDER_PREFIX other than TEST; sandbox keys never run with PULSO_MODE=live.
# ALLOW_MIXED_MODE=on allows only sandbox keys with PULSO_MODE=live, for the one-off Pulso smoke test; remove it right after.


# Production keeps the /api/test/* routes off.
NODE_ENV=production
PORT=8710
PUBLIC_URL=https://guatescoffeeroasters.co
# nginx runs on this host: makes req.ip the real client.
TRUST_PROXY=on

DB_PATH=/srv/guates/store/shared/store.db
# Relative to WorkingDirectory (releases/<ts>/server).
DIST_DIR=../app/dist

PULSO_MODE=stub-orders
INDEXING=off
ORDER_PREFIX=TEST
# Orders a single IP may create per minute (default 10).
#ORDERS_PER_MINUTE=10

STORE_ID=<pulso store id>
STORE_API_KEY=<pulso store api key>

WOMPI_PUBLIC_KEY=pub_test_<placeholder>
WOMPI_PRIVATE_KEY=prv_test_<placeholder>
WOMPI_EVENTS=test_events_<placeholder>
WOMPI_INTEGRITY=test_integrity_<placeholder>
WOMPI_LOOKUP=on

# Generate both with: node cli.js vapid-keys
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=mailto:hola@guatescoffeeroasters.co

# Optional. The store's WhatsApp, digits with the country code. Unset: the store keeps "escríbenos por WhatsApp" without a link.
#CONTACT_WHATSAPP=57<numero de whatsapp>
# Payment receipt email to the customer, sent through Brevo. Without the key no email is sent (the log says "mail off").
# The sender domain must be authenticated in Brevo (DKIM and brevo-code records in the guatescoffeeroasters.co DNS).
#BREVO_API_KEY=<llave de Brevo>
#MAIL_FROM=pedidos@guatescoffeeroasters.co
#MAIL_FROM_NAME=Guates Coffee Roasters
