# Copy to /srv/guates/store/shared/store.env on the server (owner guates, mode 600).
# Placeholders only. Never commit real values.
# Pre-launch column of the plan; the Live values are noted at the end of each line.

NODE_ENV=production                     # keeps the /api/test/* routes off
PORT=8710
PUBLIC_URL=https://guatescoffeeroasters.co
TRUST_PROXY=on                          # nginx runs on the same host; makes req.ip the real client

DB_PATH=/srv/guates/store/shared/store.db
DIST_DIR=../app/dist                    # relative to WorkingDirectory (releases/<ts>/server)

PULSO_MODE=stub-orders                  # live: live
INDEXING=off                            # live: on
ORDER_PREFIX=TEST                       # live: WEB

STORE_ID=<pulso store id>
STORE_API_KEY=<pulso store api key>

WOMPI_PUBLIC_KEY=pub_test_<placeholder>     # live: pub_prod_...
WOMPI_PRIVATE_KEY=prv_test_<placeholder>    # live: prv_prod_...
WOMPI_EVENTS=test_events_<placeholder>      # live: prod_events_...
WOMPI_INTEGRITY=test_integrity_<placeholder> # live: prod_integrity_...
WOMPI_LOOKUP=on

# Generate with: node cli.js vapid-keys
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=mailto:hola@guatescoffeeroasters.co
